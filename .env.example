DATABASE_PATH=data/connector_intelligence.db
OUTPUT_DIR=outputs
WHATSAPP_VERIFY_TOKEN=replace-with-local-placeholder
# Meta App Secret used only to validate X-Hub-Signature-256; keep private.
WHATSAPP_APP_SECRET=
# Comma-separated organizer-approved group IDs. Empty disables WhatsApp ingestion.
WHATSAPP_SELECTED_GROUPS=
# Dot path relative to each Cloud API message object; obtain from organizer fixture.
# Empty disables ingestion until the group's location is confirmed.
WHATSAPP_GROUP_ID_PATH=
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Must match the authorized hackathon sandbox mailbox; sync refuses a mismatch.
GMAIL_MAILBOX_OWNER=
# Separate token avoids replacing the Gmail readonly authorization.
GOOGLE_DRIVE_TOKEN_FILE=drive_token.json
GOOGLE_DRIVE_ACCOUNT=
REFERENCE_DATE=
# Optional only after organizer approval. No LLM provider is enabled by default.
LLM_PROVIDER=
